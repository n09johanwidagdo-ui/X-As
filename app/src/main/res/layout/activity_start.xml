<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#F3F4F6">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="32dp" android:text="Exam Browser"
            android:textColor="#111827" android:textSize="26sp" android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" android:text="Isi data berikut untuk memulai ujian"
            android:textColor="#6B7280" android:textSize="14sp" />

        <EditText android:id="@+id/etNama"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Nama lengkap" android:inputType="textPersonName|textCapWords" />

        <EditText android:id="@+id/etNis"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="NIS / No. peserta" android:inputType="text" />

        <EditText android:id="@+id/etKode"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Kode ujian" android:inputType="textCapCharacters" />

        <Button android:id="@+id/btnMulai"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="Mulai Ujian" />

        <TextView android:id="@+id/tvStatus"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:textColor="#B91C1C" android:gravity="center" />
    </LinearLayout>
</ScrollView>
